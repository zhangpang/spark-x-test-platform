{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@spark-x-test/adapter-spark-x-agent": ["adapters/spark-x-agent/src/index.ts"],
      "@spark-x-test/contracts": ["packages/contracts/src/index.ts"],
      "@spark-x-test/case-schema": ["packages/case-schema/src/index.ts"],
      "@spark-x-test/adapter-sdk": ["packages/adapter-sdk/src/index.ts"],
      "@spark-x-test/execution-engine": ["packages/execution-engine/src/index.ts"],
      "@spark-x-test/executors": ["packages/executors/src/index.ts"],
      "@spark-x-test/reporting": ["packages/reporting/src/index.ts"],
      "@spark-x-test/service-runtime": ["packages/service-runtime/src/index.ts"]
    }
  }
}
