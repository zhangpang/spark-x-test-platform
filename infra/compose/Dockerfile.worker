FROM node:22.18.0-bookworm-slim AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
COPY adapters/spark-x-agent/package.json adapters/spark-x-agent/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/scheduler/package.json apps/scheduler/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/adapter-sdk/package.json packages/adapter-sdk/package.json
COPY packages/case-schema/package.json packages/case-schema/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/execution-engine/package.json packages/execution-engine/package.json
COPY packages/executors/package.json packages/executors/package.json
COPY packages/reporting/package.json packages/reporting/package.json
COPY packages/service-runtime/package.json packages/service-runtime/package.json
RUN npm ci

FROM dependencies AS build

COPY . .
RUN npm run build

FROM node:22.18.0-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV PLAYWRIGHT_TRACE_TMPDIR=/dev/shm/spark-x-test-traces
WORKDIR /app
COPY --from=dependencies /app/node_modules /app/node_modules
RUN npx playwright install --with-deps chromium \
  && rm -rf /app/node_modules \
  && chown -R node:node /ms-playwright
COPY --chown=node:node --from=build /app /app
USER node
CMD ["node", "apps/worker/dist/main.js"]
